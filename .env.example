# Database Configuration
DATABASE_URL=postgresql://careerforge:careerforge@localhost:5432/careerforge

# JWT Configuration
# REQUIRED in production - the server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# Google Gemini AI Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# India job listings (Jooble)
# Register at https://jooble.org/api/about and never commit a real key.
JOOBLE_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Deployment-specific CORS allow-list (comma-separated exact origins), e.g. preview domains
# EXTRA_CORS_ORIGINS=https://preview.example.com

# Frontend
# Base URL of the API when the SPA is deployed separately from the server.
# Leave empty when served by the Express server (same-origin).
VITE_API_URL=
