# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://careerforge:careerforge@localhost:5432/careerforge

# JWT Configuration (Generate strong secret in production via: openssl rand -base64 32)
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# Google Gemini AI Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Shared Demo Account (Disabled automatically in production)
DEMO_MODE=false
