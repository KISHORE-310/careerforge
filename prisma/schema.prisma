generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  wishlist
  applied
  screening
  interview
  offer
  rejected
  withdrawn
}

enum JobSource {
  catalog
  live
}

enum InterviewStatus {
  in_progress
  completed
}

enum NotificationType {
  job_match
  interview
  milestone
  learning
  system
  application
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  fullName             String
  onboardingCompleted  Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  profile              Profile?
  settings             UserSettings?
  resume               Resume?
  refreshTokens        RefreshToken[]
  skills               Skill[]
  applications         Application[]
  savedJobs            SavedJob[]
  interviews           Interview[]
  roadmap              Roadmap?
  learningProgress     LearningProgress[]
  dsaProgress          DsaProgress[]
  notifications        Notification[]
  analyticsEvents      AnalyticsEvent[]
  careerSnapshots      CareerSnapshot[]
  coachMessages        CoachMessage[]
}

model Profile {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole       String  @default("Software Engineer")
  targetSalary     String  @default("")
  experienceLevel  String  @default("")
  bio              String  @default("")
  location         String  @default("")
  phone            String  @default("")
  linkedin         String  @default("")
  github           String  @default("")
  portfolio        String  @default("")
  careerGoal       String  @default("")
  avatar           String  @default("")
}

model UserSettings {
  id                    String  @id @default(cuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobMatchAlerts        Boolean @default(true)
  interviewReminders    Boolean @default(true)
  weeklyDigest          Boolean @default(true)
  aiTone                String  @default("professional")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Resume {
  id               String          @id @default(cuid())
  userId           String          @unique
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentVersionId String?
  versions         ResumeVersion[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model ResumeVersion {
  id             String   @id @default(cuid())
  resumeId       String
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  versionNumber  Int
  content        Json
  extractedText  String?  @db.Text
  source         String
  label          String   @default("")
  createdAt      DateTime @default(now())

  @@unique([resumeId, versionNumber])
  @@index([resumeId])
}

model Skill {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  category    String @default("Technical")
  proficiency Int    @default(50)
  status      String @default("learning")

  @@unique([userId, name])
  @@index([userId])
}

model Company {
  id              String  @id @default(cuid())
  name            String  @unique
  industry        String  @default("")
  headquarters    String  @default("")
  size            String  @default("")
  rating          Float?
  recommendRate   Int?
  hiringVelocity  String  @default("")
  avgSalary       String  @default("")
  techStack       Json
  culture         String  @default("") @db.Text
  description     String  @default("") @db.Text
  openRolesCount  Int     @default(0)
  source          JobSource @default(catalog)
  jobs            Job[]
}

model Job {
  id              String    @id @default(cuid())
  externalId      String?
  title           String
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id])
  companyName     String
  location        String    @default("")
  salary          String    @default("")
  equity          String    @default("")
  type            String    @default("Full-time")
  experience      String    @default("")
  workplace       String    @default("Remote")
  department      String    @default("")
  description     String    @db.Text
  requirements    Json
  skillsRequired  Json
  benefits        Json
  source          JobSource @default(catalog)
  sourceUrl       String    @default("")
  fetchedAt       DateTime  @default(now())
  expiresAt       DateTime?
  isExpired       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  applications    Application[]
  savedBy         SavedJob[]

  @@unique([source, externalId])
  @@index([companyName])
  @@index([title])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
}

model Application {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company     String
  role        String
  location    String             @default("")
  salary      String             @default("")
  status      ApplicationStatus  @default(applied)
  appliedDate DateTime           @default(now())
  jobUrl      String             @default("")
  notes       String             @default("") @db.Text
  contacts    String             @default("")
  nextStep    String             @default("")
  followUpAt  DateTime?
  interviewAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, status])
}

model Interview {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String
  type             String
  company          String            @default("")
  status           InterviewStatus   @default(in_progress)
  durationMinutes  Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  messages         InterviewMessage[]
  evaluation       InterviewEvaluation?
}

model InterviewMessage {
  id             String    @id @default(cuid())
  interviewId    String
  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  sender         String
  text           String    @db.Text
  microFeedback  String?   @db.Text
  createdAt      DateTime  @default(now())

  @@index([interviewId])
}

model InterviewEvaluation {
  id                   String    @id @default(cuid())
  interviewId          String    @unique
  interview            Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  overallScore         Int
  clarityScore         Int
  technicalScore       Int
  impactScore          Int
  summary              String    @db.Text
  strengths            Json
  improvements         Json
  method               String
  createdAt            DateTime  @default(now())
}

model Roadmap {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole  String
  source      String             @default("skill_gap")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  milestones  RoadmapMilestone[]
}

model RoadmapMilestone {
  id          String   @id @default(cuid())
  roadmapId   String
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  week        Int
  title       String
  description String   @db.Text
  duration    String   @default("")
  status      String   @default("todo")
  sortOrder   Int      @default(0)
  tasks       Json
}

model LearningResource {
  id           String             @id @default(cuid())
  skill        String
  title        String
  category     String
  duration     String
  estimatedHours Float            @default(1)
  difficulty   String
  type         String
  description  String             @db.Text
  lessons      Json
  quiz         Json?
  progress     LearningProgress[]
}

model LearningProgress {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId         String
  resource           LearningResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  completedLessonIds Json
  progressPct        Int              @default(0)
  completed          Boolean          @default(false)
  updatedAt          DateTime         @updatedAt

  @@unique([userId, resourceId])
}

model DsaProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicSlug   String
  problemSlug String
  status      String   @default("unsolved")
  bookmarked  Boolean  @default(false)
  notes       String   @default("") @db.Text
  attempts    Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, topicSlug, problemSlug])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(system)
  read      Boolean          @default(false)
  actionUrl String           @default("")
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId, type, createdAt])
}

model CareerSnapshot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics   Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model CoachMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender    String
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model MarketInsight {
  id        String   @id @default(cuid())
  kind      String
  payload   Json
  source    String   @default("catalog")
  updatedAt DateTime @updatedAt
}
