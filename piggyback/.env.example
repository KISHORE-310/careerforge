# SH-205 · Intelligent Shipment Piggybacking — environment configuration
# Copy to .env (git-ignored) and adjust. The demo runs fine with all defaults.

# --- Application -------------------------------------------------------
APP_ENV=development            # development | production
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=*                 # comma-separated origins, e.g. http://localhost:5173

# --- Simulation --------------------------------------------------------
SIMULATION_SEED=42             # deterministic world generation / demo replay
TICK_SECONDS_REAL=1.0          # real seconds per simulation tick
SIM_HOURS_PER_TICK=1.0         # simulated hours per tick (1s = 1h default)
MAX_CONCURRENT_MISPLACED=15    # anomaly budget so the demo stays playable

# --- Detection thresholds ---------------------------------------------
STALE_SCAN_HOURS=8
ROUTE_DEVIATION_KM=50
DELAY_TOLERANCE_BUFFER_HOURS=0

# --- Scoring weights (must be >= 0; at least one > 0) --------------------
W_COST=0.30
W_TIME=0.30
W_PRIORITY=0.20
W_CO2=0.20
W_RISK=0.10

# --- AI layer (optional; leave empty for deterministic fallback) --------
# The optimizer NEVER depends on this. With no key, explanations are
# generated by the deterministic template explainer.
AI_PROVIDER=                   # "" (off) | openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_S=8

# --- Frontend (Vite: VITE_* prefix, set in frontend/.env) ---------------
# VITE_API_URL=http://127.0.0.1:8000
# VITE_WS_URL=ws://127.0.0.1:8000
